# The receiver reads only where it runs from the environment. Everything the
# device or HR can be wrong about is a database row (SPEC.md §9).
POSTGRES_PASSWORD=hr

# Half of the device's Cloud Server Setting. Changing it means changing the
# setting on the device (SPEC.md §10).
RECEIVER_PORT=8080
DATABASE_URL=postgresql+psycopg://hr:hr@127.0.0.1:5432/hr_attendance
